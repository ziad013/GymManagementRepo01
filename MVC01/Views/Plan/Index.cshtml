@model IEnumerable<PlanViewModel>

@{
    ViewData["Title"] = "Plans";
}
@if (TempData["ErrorMessage"] is not null || TempData["SuccessMessage"] is not null)
{
    <div class="toasts" role="status" aria-live="polite">

        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="toast-r"><i class="bi bi-check-circle-fill"></i><span>@TempData["SuccessMessage"]</span><button type="button" aria-label="Close">&times;</button></div>
        }

        @if (TempData["ErrorMessage"] is not null)
        {
            <div class="toast-r error"><i class="bi bi-exclamation-circle-fill"></i><span>@TempData["ErrorMessage"]</span><button type="button" aria-label="Close">&times;</button></div>
        }
    </div>
}

                <div class="page-head">
                    <div>
                        <h1 class="page-title">Plans</h1>
                        <p class="page-sub">What members can subscribe to</p>
                    </div>
                </div>

                <div class="callout" style="margin-bottom:22px">
                    <i class="bi bi-shield-check"></i>
                    <div>A plan with <strong>active or upcoming memberships</strong> is locked: it can't be edited or deactivated until those memberships end. Inactive plans can't be sold or edited.</div>
                </div>

 
                @if (!Model.Any())
                    {
                        <div class="card-r empty" style="margin-top:22px">
                            <div class="empty-icon"><i class="bi bi-tags"></i></div>
                            <h3>No plans found</h3>
                        </div>
                    }
                    else
                    {


                        <div class="grid-cards">
                            @foreach (var plan in Model)
                            {
                                <div class="card-r plan-card @(plan.IsActive ? "" : "inactive")">
                                    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                                        <h2 class="plan-name">@plan.Name</h2>
                                        @if (plan.IsActive)
                                        {
                                            <span class="badge-r badge-ok">Active</span>
                                        }else
                                        {
                                        <span class="badge-r badge-mute">Inactive</span>
                                        }
                                    </div>
                                    <div class="plan-price">@plan.Price.ToString("N0")<small>EGP</small></div>
                                    <div class="plan-meta"><i class="bi bi-calendar-range"></i>@plan.DurationDays days</div>
                                    <p class="plan-desc">@plan.Description</p>
 
                                <div class="card-foot">
                                        @if(plan.IsActive){
                                           
                                        <a class="btn-r btn-outline-r btn-sm-r" asp-action="Edit" asp-route-id="@plan.Id"><i class="bi bi-pencil"></i> Edit</a>
                                        <form asp-action="#" asp-route-id="@plan.Id" method="post" style="flex:1;display:flex" data-confirm="Deactivate @plan.Name ? It won't be available for new memberships.">
                                            <button type="submit" class="btn-r btn-soft-danger btn-sm-r" style="flex:1"><i class="bi bi-pause-circle"></i> Deactivate</button>
                                        </form>
                                        }
                                        else
                                        {
                                        <form asp-action="#" asp-route-id="@plan.Id" method="post" style="flex:1;display:flex">
                                            <button type="submit" class="btn-r btn-soft-ok btn-sm-r" style="flex:1"><i class="bi bi-play-circle"></i> Activate</button>
                                        </form>
                                        }
                                    </div>
                                </div>
                            }
               

                        </div>

                    }
